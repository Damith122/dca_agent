# Candidate for PAPER validation only. Not an assertion of profitability.
DRY_RUN=true
USE_TESTNET=false
LIVE_TRADING_CONFIRMATION=false
I_UNDERSTAND_THIS_IS_REAL_MONEY=no
PAPER_START_BALANCE_USDT=15
SYMBOL=SOLUSDT
ACTIVE_SYMBOLS=SOLUSDT,SUIUSDT
MAX_ACTIVE_TRADES=1
INITIAL_ENTRY_USDT=2
LEVERAGE=5
MAX_DCA_STEPS=0
ENTRY_SCORE_THRESHOLD=0.75
CONTINUOUS_24_7_TRADING=false
DAILY_PROFIT_TARGET_USDT=0.50
MAX_DAILY_LOSS_USDT=0.30
EXPOSURE_GUARD_ENABLED=true
EXPOSURE_HEADROOM_PCT=0.03
EXPOSURE_MAINTENANCE_FLOOR_PCT=0.01
EXPOSURE_COST_RESERVE_PCT=0.002
EXPOSURE_RECHECK_SEC=10
FEATURE_RECORDER_ENABLED=true
DRY_FILL_ENABLED=true
# Current simulator models market fills, not maker queue priority.
USE_POST_ONLY_LIMIT=false
DRY_FILL_SLIPPAGE_BPS=2
PROFIT_LOCK_SLIPPAGE_ATR_MULT=0.25
# Blank overrides restore config's notional-scaled dollar thresholds.
MAX_STOP_LOSS_USD=
MIN_STOP_LOSS_USD=
TARGET_PROFIT_USD=
MIN_TARGET_PROFIT_USD=
MAX_TRADE_NET_LOSS_USDT=
MAX_TRADE_EXIT_BUFFER_USDT=
SMART_ORDERFLOW_EXIT_MIN_LOSS_USD=
SMART_ORDERFLOW_EXIT_MAX_LOSS_USD=
DCA_RESCUE_BREAKEVEN_MIN_NET_USD=
SL_ATR_MULT=2.5
# Omit all *_PATH overrides; defaults now include PAPER_LIVE + symbol.
# Use a separate GITHUB_BRANCH for paper records if sync is enabled.
